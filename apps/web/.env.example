# Base URL of the API the web app calls.
VITE_API_URL=http://localhost:3000

# Auth0 settings. These are public identifiers, not secrets.
# Applications > your Single Page Application > Settings > Domain (no https://).
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# Applications > your Single Page Application > Settings > Client ID.
VITE_AUTH0_CLIENT_ID=your-client-id
# Applications > APIs > your API > Identifier. Must match AUTH0_AUDIENCE in apps/api.
VITE_AUTH0_AUDIENCE=https://api.ai-wellness-coach
