{
  "name": "@ai-wellness-coach/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev:worker": "wrangler dev",
    "ai:smoke": "tsx --env-file-if-exists=.env src/ai/smoke.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.73",
    "@ai-wellness-coach/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "ai": "7.0.129",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  }
}
