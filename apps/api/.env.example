# Set to "production" when deployed. In production, CORS_ORIGIN must be set.
# NODE_ENV=production

# Port the API listens on (default 3000).
PORT=3000

# Origin of the web app that is allowed to call the API (CORS).
# Defaults to http://localhost:5173 outside production.
CORS_ORIGIN=http://localhost:5173

# Postgres connection string (Neon). Use the DIRECT connection string (the host
# has no "-pooler") for migrations. Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Auth0 tenant domain, without https:// (Applications > your app > Settings > Domain).
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Auth0 API identifier, used as the token audience (Applications > APIs > Identifier).
AUTH0_AUDIENCE=https://api.ai-wellness-coach

# Anthropic API key (Anthropic console > API keys). A secret: never commit the
# real value. In production it is a Worker secret, not a wrangler.jsonc var.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: also allow pull request preview sites under this host suffix.
# Production sets this in wrangler.jsonc; leave unset locally.
# CORS_PREVIEW_HOST_SUFFIX=.ai-wellness-coach.pages.dev

# Optional: only for `pnpm --filter @ai-wellness-coach/api dev:worker`. Use the
# same value as DATABASE_URL (a development database, never production).
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
