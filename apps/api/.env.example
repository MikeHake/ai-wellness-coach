# Set to "production" when deployed. In production, CORS_ORIGIN must be set.
# NODE_ENV=production

# Port the API listens on (default 3000).
PORT=3000

# Origin of the web app that is allowed to call the API (CORS).
# Defaults to http://localhost:5173 outside production.
CORS_ORIGIN=http://localhost:5173

# Postgres connection string (Neon). Use the DIRECT connection string (the host
# has no "-pooler") for migrations. Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
